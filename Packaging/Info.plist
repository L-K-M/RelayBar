<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>RelayBarScion</string>
    <key>CFBundleIdentifier</key>
    <string>com.relaybarscion.RelayBarScion</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>RelayBar Scion</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.4.0</string>
    <key>CFBundleVersion</key>
    <string>8</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>RelayBar connects to SSH hosts on your local network to create tunnels.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 RelayBar Scion</string>
    <!-- No SUFeedURL or SUPublicEDKey: this fork has no update feed of its
         own, and upstream's feed and signing key would replace this build with
         upstream's. Sparkle's start() throws without them, which the updater
         service logs before carrying on, leaving Check for Updates… disabled.
         Add both keys together when this fork publishes releases. -->
    <key>SURequireSignedFeed</key>
    <true/>
    <key>SUEnableAutomaticChecks</key>
    <false/>
    <key>SUAutomaticallyUpdate</key>
    <false/>
    <key>SUAllowsAutomaticUpdates</key>
    <false/>
    <key>SUScheduledCheckInterval</key>
    <integer>604800</integer>
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>
</dict>
</plist>
