<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>RelayBarScion</string>
    <key>CFBundleIdentifier</key>
    <string>com.relaybarscion.RelayBarScion</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>RelayBar Scion</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- Both version keys expand from the Xcode build settings (Info.plist files
         named by INFOPLIST_FILE get build-setting substitution), so the pbxproj's
         MARKETING_VERSION / CURRENT_PROJECT_VERSION are the single source of truth
         and scripts/release.sh can bump every copy in lockstep. -->
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>RelayBar Scion connects to SSH hosts on your local network to create tunnels.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 RelayBar Scion</string>
    <!-- No SUFeedURL or SUPublicEDKey: this fork has no update feed of its
         own, and upstream's feed and signing key would replace this build with
         upstream's. Sparkle's start() throws without them, which the updater
         service logs before carrying on, leaving Check for Updates… disabled.
         Add both keys together when this fork publishes releases. -->
    <key>SURequireSignedFeed</key>
    <true/>
    <key>SUEnableAutomaticChecks</key>
    <false/>
    <key>SUAutomaticallyUpdate</key>
    <false/>
    <key>SUAllowsAutomaticUpdates</key>
    <false/>
    <key>SUScheduledCheckInterval</key>
    <integer>604800</integer>
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>
</dict>
</plist>
